:root {
  --bg: #f6f5f2;
  --ink: #1a1a1a;
  --muted: #5c5c5c;
  --card: #ffffff;
  --line: #e4e1db;
  --accent: #1a1a1a;
}
*,
*::before,
*::after {
  box-sizing: border-box;
}
body {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  color: var(--ink);
  background: var(--bg);
  min-height: 100vh;
}
.site-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--line);
  background: #fff;
}
.logo {
  display: inline-flex;
  align-items: center;
  gap: 0;
  text-decoration: none;
  color: inherit;
  font-size: 1.75rem;
  letter-spacing: 0.02em;
  line-height: 1;
}
.logo-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  background: #000;
  color: #fff;
  font-family: Arial, Helvetica, sans-serif;
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 0.04em;
}
.logo-word {
  margin-left: 0.35rem;
  font-style: italic;
}
.page {
  width: min(36rem, calc(100% - 2rem));
  margin: 2.5rem auto 4rem;
}
.intro h1 {
  margin: 0 0 0.4rem;
  font-size: 1.85rem;
  font-weight: 400;
}
.intro p {
  margin: 0 0 1.75rem;
  color: var(--muted);
}
.profile-form {
  display: grid;
  gap: 1.15rem;
  padding: 1.5rem;
  background: var(--card);
  border: 1px solid var(--line);
}
.profile-form label {
  display: grid;
  gap: 0.4rem;
  font-size: 0.9rem;
  font-family: Arial, Helvetica, sans-serif;
  letter-spacing: 0.02em;
}
.profile-form input,
.profile-form textarea {
  width: 100%;
  padding: 0.7rem 0.8rem;
  border: 1px solid var(--line);
  background: #fafafa;
  font: inherit;
  color: inherit;
  resize: vertical;
}
.profile-form input:focus,
.profile-form textarea:focus {
  outline: 2px solid var(--ink);
  outline-offset: 1px;
  background: #fff;
}
.profile-form button {
  justify-self: start;
  margin-top: 0.25rem;
  padding: 0.7rem 1.4rem;
  border: 0;
  background: #000;
  color: #fff;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 0.9rem;
  cursor: pointer;
}
.profile-form button:hover {
  background: #333;
}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELate — Profile</title>
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="index.html" aria-label="ELate home">
        <span class="logo-mark">EL</span>
        <span class="logo-word">ate</span>
      </a>
    </header>
    <main class="page">
      <section class="intro">
        <h1>Tell us about you</h1>
        <p>Share your background so we can match you with the right roles.</p>
      </section>
      <form class="profile-form" action="#" method="post">
        <label>
          Name
          <input type="text" name="name" placeholder="Your full name" required />
        </label>
        <label>
          Skills
          <textarea
            name="skills"
            rows="4"
            placeholder="e.g. Python, SQL, product design"
            required
          ></textarea>
        </label>
        <label>
          Target role
          <input
            type="text"
            name="target_role"
            placeholder="e.g. Software Engineer, Product Manager"
            required
          />
        </label>
        <label>
          Preferred companies
          <textarea
            name="preferred_companies"
            rows="3"
            placeholder="e.g. Google, Stripe, a local startup"
          ></textarea>
        </label>
        <button type="submit">Submit</button>
      </form>
    </main>
  </body>
</html>
$root = Split-Path -Parent $MyInvocation.MyCommand.Path
$prefix = "http://127.0.0.1:8765/"
$listener = New-Object System.Net.HttpListener
$listener.Prefixes.Add($prefix)
$listener.Start()
Write-Output "Serving $root at $prefix"
$mime = @{
  ".html" = "text/html; charset=utf-8"
  ".css"  = "text/css; charset=utf-8"
  ".js"   = "text/javascript; charset=utf-8"
  ".png"  = "image/png"
  ".svg"  = "image/svg+xml"
}
while ($listener.IsListening) {
  $ctx = $listener.GetContext()
  $rel = $ctx.Request.Url.LocalPath
  if ($rel -eq "/") { $rel = "/index.html" }
  $file = Join-Path $root ($rel.TrimStart("/").Replace("/", "\"))
  if (Test-Path $file -PathType Leaf) {
    $bytes = [System.IO.File]::ReadAllBytes($file)
    $ext = [System.IO.Path]::GetExtension($file).ToLowerInvariant()
    $ctx.Response.ContentType = $(if ($mime.ContainsKey($ext)) { $mime[$ext] } else { "application/octet-stream" })
    $ctx.Response.StatusCode = 200
    $ctx.Response.OutputStream.Write($bytes, 0, $bytes.Length)
  } else {
    $msg = [System.Text.Encoding]::UTF8.GetBytes("Not found")
    $ctx.Response.StatusCode = 404
    $ctx.Response.OutputStream.Write($msg, 0, $msg.Length)
  }
  $ctx.Response.Close()
}
