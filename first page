<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELate — Profile</title>
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="index.html" aria-label="ELate home">
        <span class="logo-mark">EL</span>
        <span class="logo-word">ate</span>
      </a>
    </header>

    <main class="page">
      <section class="intro">
        <h1>Tell us about you</h1>
        <p>Share your background so we can match you with the right roles.</p>
      </section>

      <form class="profile-form" action="#" method="post">
        <label>
          Name
          <input type="text" name="name" placeholder="Your full name" required />
        </label>

        <label>
          Skills
          <textarea
            name="skills"
            rows="4"
            placeholder="e.g. Python, SQL, product design"
            required
          ></textarea>
        </label>

        <label>
          Target role
          <input
            type="text"
            name="target_role"
            placeholder="e.g. Software Engineer, Product Manager"
            required
          />
        </label>

        <label>
          Preferred companies
          <textarea
            name="preferred_companies"
            rows="3"
            placeholder="e.g. Google, Stripe, a local startup"
          ></textarea>
        </label>

        <button type="submit">Submit</button>
      </form>
    </main>
  </body>
</html>
