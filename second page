<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Target, Readiness & Recommendation</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 40px;
            padding: 20px;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .sections {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .card {
            background: white;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }

        .card-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin-bottom: 15px;
        }

        .card-title {
            font-size: 1.5em;
            color: #333;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .card-content {
            color: #666;
            line-height: 1.6;
            font-size: 1em;
        }

        .card-list {
            list-style-position: inside;
            color: #666;
            line-height: 1.8;
        }

        .card-list li {
            margin-bottom: 8px;
        }

        .target .card-icon {
            background-color: #667eea;
            color: white;
        }

        .readiness .card-icon {
            background-color: #f093fb;
            color: white;
        }

        .recommendation .card-icon {
            background-color: #4facfe;
            color: white;
        }

        .footer {
            text-align: center;
            color: white;
            padding: 20px;
            opacity: 0.8;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 1.8em;
            }

            .sections {
                gap: 20px;
            }

            .card {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Assessment Dashboard</h1>
            <p>Target, Readiness & Recommendations Overview</p>
        </div>

        <div class="sections">
            <!-- Target Section -->
            <div class="card target">
                <div class="card-icon">🎯</div>
                <div class="card-title">Target</div>
                <div class="card-content">
                    <p>Define the objectives and goals for your project or initiative.</p>
                    <ul class="card-list">
                        <li>Clear objectives</li>
                        <li>Measurable outcomes</li>
                        <li>Timeline alignment</li>
                        <li>Success criteria</li>
                    </ul>
                </div>
            </div>

            <!-- Readiness Section -->
            <div class="card readiness">
                <div class="card-icon">✅</div>
                <div class="card-title">Readiness</div>
                <div class="card-content">
                    <p>Assess the current state and preparedness for implementation.</p>
                    <ul class="card-list">
                        <li>Resource availability</li>
                        <li>Capability assessment</li>
                        <li>Risk evaluation</li>
                        <li>Stakeholder alignment</li>
                    </ul>
                </div>
            </div>

            <!-- Recommendation Section -->
            <div class="card recommendation">
                <div class="card-icon">💡</div>
                <div class="card-title">Recommendation</div>
                <div class="card-content">
                    <p>Strategic recommendations based on analysis and findings.</p>
                    <ul class="card-list">
                        <li>Next steps</li>
                        <li>Action items</li>
                        <li>Optimization strategies</li>
                        <li>Improvement areas</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer">
            <p>&copy; 2024 Assessment Dashboard. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
